# Base PostgreSQL (sur Railway : ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easycompta
# IA : "gemini" (Google, quota gratuit) ou "claude" (API Anthropic, payante)
AI_PROVIDER=gemini
# Clé Gemini gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# Clé API Claude (https://console.anthropic.com) si AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# Secret des sessions : une longue chaîne aléatoire
JWT_SECRET=
# Optionnel
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium
# AI_MIN_CONFIDENCE=0.75
# WORKER_CONCURRENCY=2
# PUBLIC_URL=https://votre-domaine.tn
# AI_MOCK=1   # mode démo sans IA (réponses factices)
